new file mode 100644
index 0000000..473d568
--- /dev/null
+++ b/platform/PlatformPcr.c
@@ -0,0 +1,194 @@
+/* SPDX-License-Identifier: BSD-2-Clause */
+/*
+ * Copyright (c) 2026, Siemens AG
+ */
+// Copied from the TCG reference implementation, see
+// https://github.com/TrustedComputingGroup/TPM/tree/main/TPMCmd/Platform/src/PlatformPcr.c, tag V184
+/*
+ * TCG Reference Implementation for TPM 2.0
+ * This code is informative.
+ *
