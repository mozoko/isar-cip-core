# check condition by calling function given via argument 1
# if the function does not return true(0) check again
# every second for up to 30 seconds
wait_30sec_for_condition() {
    check_condition="$1"
    if [ -z "$check_condition" ]; then
        panic "Argument for function wait_30sec_for_condition is empty"
        return 0
    fi
    while true; do
        sleep 1
        if "$check_condition" ; then
            log_end_msg 1
            break
        fi
        if [ "$(time_elapsed)" -ge 30 ]; then
            log_end_msg 0
            break
        fi
    done
}

# check if the device "$ROOT" is valid
find_root_by_part() {
    found_root=$(blkid --list-one --output device --match-token "$ROOT")
    if [ -n "${found_root}" ]; then
        return 0
    fi
    return 1
}

# This function should be overridden by the user of scan_for_partitions
find_root_via_image_uuid(){
    :
}

# scan partitions for the root device defined by
# the function find_root_via_image_uuid
scan_for_partitions() {
    for part in $(blkid -o device); do
        unset found
        for scanned_part in ${scanned_partitions}; do
            if [ "${scanned_part}" = "${part}" ]; then
                found=1
                break
            fi
        done
        if [ -z "${found}" ]; then
            partitions="${partitions} ${part}"
        fi
    done
    scanned_partitions="${scanned_partitions} ${partitions}"
    find_root_via_image_uuid "$partitions"
    if [ -n "${found_root}" ]; then
        return 0
    fi
    return 1
}

# check if system was securely booted via UEFI
secure_boot_enabled() {
    efivars=/sys/firmware/efi/efivars
    if ! mountpoint -q $efivars; then
        mount -t efivarfs none $efivars
    fi

    secure_boot="$efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c"
    setup_mode="$efivars/SetupMode-8be4df61-93ca-11d2-aa0d-00e098032b8c"
    if printf '\001' | cmp -s -i 4:0 $secure_boot &&
       printf '\000' | cmp -s -i 4:0 $setup_mode; then
        return 0
    fi
    return 1
}

service_watchdog() {
    watchdog_dev="$1"
    setup_timeout="$2"
    if [ ! -e "$watchdog_dev" ]; then
        panic "Could not find '$watchdog_dev' - Please check your kernel configuration."
    fi
    for _ in $(seq $((setup_timeout / 10)) ); do
        printf '\0'
        sleep 10
    done > "$watchdog_dev"
}

# start_watchdog and stop_watchdog share $watchdog_pid via the shell
# environment, so both have to be called from the same script.
start_watchdog() {
    if [ -z "$1" ] || [ -z "$2" ]; then
        log_warning_msg "Watchdog is disabled."
        return 0
    fi
    if [ -z "$watchdog_pid" ]; then
        service_watchdog "$1" "$2" &
        watchdog_pid=$!
    fi
}

stop_watchdog() {
    if [ -n "$watchdog_pid" ]; then
        while kill -9 "$watchdog_pid" 2>/dev/null; do
            sleep 1
        done
        watchdog_pid=""
    fi
}
